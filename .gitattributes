# Written by Kone Tshivhinda & Claude
# Test documents are byte-exact fixtures: line-ending conversion would corrupt them
# (a PDF records the byte offset of every object).
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.tif binary
*.tiff binary

# Migrations are checked by a hash of their exact bytes: a Windows checkout that turned the line
# endings into CRLF made a database that had applied them refuse to start ("previously applied but
# has been modified"). Always Unix line endings, on every platform.
crates/clearcut-store/migrations/*.sql text eol=lf

# Generated contract files are compared byte for byte by a test.
contracts/*.json text eol=lf

# Shell scripts run on Linux servers, where a CRLF checkout fails at the first line.
*.sh text eol=lf
