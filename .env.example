# Copy to .env (never commit .env). Written by Kone Tshivhinda & Claude
CLEARCUT_BIND=127.0.0.1:8080
RUST_LOG=info

# Per-account limits and retention (optional; these are the defaults). A request over the rate is
# answered 429 with Retry-After; an upload that would overfill the account is answered 507.
# CLEARCUT_TENANT_QUOTA_BYTES=1073741824
# CLEARCUT_RATE_LIMIT_PER_MINUTE=120
# Documents older than this many days are erased automatically, file and readings included
# (audit and call log stay). 0 turns it off and documents are kept until deleted.
# CLEARCUT_RETENTION_DAYS=365

# The guard in front of authentication (optional; these are the defaults). Checked before the
# database is asked about a key, so a flood of wrong keys costs a map lookup, not a query.
# A request over an address's minute, or from a blocked address, is answered 429 with Retry-After.
# CLEARCUT_PER_IP_PER_MINUTE=300
# Failed credentials an address may present in a minute before it waits CLEARCUT_BLOCK_SECONDS.
# CLEARCUT_AUTH_FAILURES_PER_MINUTE=20
# CLEARCUT_BLOCK_SECONDS=60
# Requests in flight before the server answers 503 and sheds load.
# CLEARCUT_MAX_CONCURRENT=256
# The longest a request may take before it is cancelled and answered 408.
# CLEARCUT_REQUEST_TIMEOUT_SECONDS=120
# Set to 1 only when a proxy that appends X-Forwarded-For (Caddy, per docs/DEPLOY.md) is in front.
# With it off, the address is the socket peer, which is right for a directly reachable server.
# CLEARCUT_TRUST_PROXY=1

# Postgres for the store tests (local dev container with no password, bound to 127.0.0.1; see CONTRIBUTING.md)
DATABASE_URL=postgres://clearcut@127.0.0.1:54329/clearcut

# Model provider (never commit real keys; load from env or a secrets manager)
ANTHROPIC_API_KEY=

# ---- Running ClearCut with Docker (docker compose; see docs/RUN-LOCALLY.md and docs/DEPLOY.md) ----
# Letters and digits only, long, and different from each other:
CLEARCUT_WORKER_TOKEN=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# A deployment where every account brings its own Anthropic key (docs/BYOK.md section 3b):
#   CLEARCUT_MASTER_KEY=<from: docker compose run --rm admin generate-master-key>   (keep a copy somewhere safe)
#   CLEARCUT_KEY_MODE=tenant-only          (the server's own ANTHROPIC_API_KEY is then never used)
#   CLEARCUT_RUNNER_CONCURRENCY=4          (documents read at once; never two of the same account)
# HTTPS (docker compose --profile https up -d): the name that points at this machine
#   CLEARCUT_DOMAIN=clearcut.example.com
